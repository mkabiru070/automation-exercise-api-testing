  "item": [
    {
      "name": "API_001_Get_All_Products_List",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code should be 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\n\r\npm.test(\"Response should contain products\", function () {\r\n    let jsonData = pm.response.json();\r\n    pm.expect(jsonData.products).to.exist;\r\n});\r\n\r\n\r\npm.test(\"Product should contain name field\", function () {\r\n    let jsonData = pm.response.json();\r\n    pm.expect(jsonData.products[0]).to.have.property(\"name\");\r\n});\r\n\r\n\r\npm.test(\"Product should contain price field\", function () {\r\n    let jsonData = pm.response.json();\r\n    pm.expect(jsonData.products[0]).to.have.property(\"price\");\r\n});"
            ]
          }
        }
      ],
